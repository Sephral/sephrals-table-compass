<div class="stc-body">
  <div class="stc-progress" aria-hidden="true"><span style="width: {{progress}}%"></span></div>
  <div class="stc-poll-head">
    <span class="stc-grow stc-strong">{{localize "STC.Poll.question"}}</span>
    <span class="stc-muted">{{localize "STC.Poll.left" seconds=left}}</span>
  </div>
  <div class="stc-faces">
    {{#each faces}}
    <button type="button" class="stc-face stc-face-{{face}} {{#if on}}on{{/if}}" data-action="face" data-face="{{face}}"
            aria-label="{{label}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">
      <svg viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="17" class="stc-face-head"></circle>
        <circle cx="14" cy="16" r="2" class="stc-face-eye"></circle>
        <circle cx="26" cy="16" r="2" class="stc-face-eye"></circle>
        <path d="{{mouth}}" class="stc-face-mouth"></path>
      </svg>
      <span>{{label}}</span>
    </button>
    {{/each}}
  </div>
  <p class="stc-hint">{{#if answered}}{{localize "STC.Poll.thanks"}}{{else}}{{localize "STC.Poll.hint"}}{{/if}}</p>
</div>
